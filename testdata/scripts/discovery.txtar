# Recursive selection covers all platforms, test files, and nested modules without
# loading dependencies. Generated files and excluded directories are untouched.

cp project/generated.go original-generated
exec format-structs -root project ./... linux.go
cmp stdout paths
! stderr .
cmp project/linux.go expected-linux
cmp project/nested/windows_amd64.go expected-windows
cmp project/sample_test.go expected
cmp project/generated.go original-generated
exec format-structs -root project -check
! stdout .
! stderr .

-- paths --
linux.go
nested/windows_amd64.go
sample_test.go
-- project/linux.go --
//go:build linux

package sample
var x = []int{1, 2}
-- project/nested/windows_amd64.go --
//go:build windows

package sample
var x = []int{1, 2}
-- project/sample_test.go --
package sample
var x = []int{1, 2}
-- project/nested/go.mod --
module example.com/nested

go 1.27.0
-- project/generated.go --
// Code generated by fixture. DO NOT EDIT.
package sample
var x=[]int{1,2}
-- project/vendor/ignore.go --
invalid
-- project/testdata/ignore.go --
invalid
-- project/.hidden/ignore.go --
invalid
-- expected --
package sample

var x = []int{
	1,
	2,
}
-- expected-linux --
//go:build linux

package sample

var x = []int{
	1,
	2,
}
-- expected-windows --
//go:build windows

package sample

var x = []int{
	1,
	2,
}
